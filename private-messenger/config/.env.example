# Normally written by the web installer (/install). Only create manually if the installer
# cannot write config/.env. Keep this file private (chmod 600). Never commit it.
APP_KEY="<base64 of 32 random bytes>"
APP_PATH="<16 random letters/digits — the secret user URL segment>"
ADMIN_PATH="<16 different random letters/digits — the secret admin URL segment>"
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME=""
DB_USER=""
DB_PASS=""
